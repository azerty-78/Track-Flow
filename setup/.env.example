# =============================================================================
# TrackFlow — setup/.env.example
# =============================================================================
# Copiez vers .env et adaptez les secrets :
#   cp .env.example .env
# =============================================================================

NODE_ENV=production

POSTGRES_USER=trackflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=trackflow-db
POSTGRES_PORT=5432
POSTGRES_HOST=trackflow

DATABASE_URL=postgresql://trackflow:change-me-strong-password@localhost:5432/trackflow-db?schema=public
DATABASE_URL_DOCKER=postgresql://trackflow:change-me-strong-password@trackflow:5432/trackflow-db?schema=public

APP_NAME=TrackFlow
APP_URL=https://trackflow.cm
APP_PORT=3000
