# =============================================================================
# TrackFlow — exemple de variables d'environnement
# =============================================================================
# Copiez ce fichier vers .env et adaptez les valeurs :
#   cp .env.example .env
# =============================================================================

# --- Application ---
NEXT_PUBLIC_APP_NAME=TrackFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_LOCALE=fr
NEXT_PUBLIC_APP_TAGLINE=Suivez vos marchandises de la Chine au Cameroun
NEXT_PUBLIC_APP_DESCRIPTION=Plateforme de gestion et de suivi des opérations logistiques et d'importation pour les entreprises.

# --- Contact / support (affichage UI) ---
NEXT_PUBLIC_SUPPORT_EMAIL=contact@trackflow.cm
NEXT_PUBLIC_SUPPORT_PHONE=+237 6 XX XX XX XX
NEXT_PUBLIC_SUPPORT_ADDRESS=Douala, Cameroun

# --- Environnement ---
NODE_ENV=development

